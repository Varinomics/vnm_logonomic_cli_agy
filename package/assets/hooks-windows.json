{
  "logonomic-hook-relay": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
        "timeout": 65
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 65
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
        "timeout": 65
      }
    ]
  }
}
